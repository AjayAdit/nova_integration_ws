<mujoco model="nova_tracking_world">


    <compiler angle="degree"  coordinate="local" /> 
    <option gravity="0 0 -9.81" timestep="0.002" />
    <visual>
        <headlight ambient="1 1 1" diffuse="1 1 1" specular="0 0 0"/>
        <global offwidth="1280" offheight="960"/>
    </visual>

<asset>
        <texture name="skybox" type="skybox" builtin="flat" rgb1="1 1 1" rgb2="1 1 1" width="512" height="512"/>
        <texture type="2d" name="grid" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.8 0.8 0.8" width="512" height="512"/>   
        <material name="grid_material" texture="grid" texuniform="true" texrepeat="10 10" reflectance="0"/>
        
        <material name="carbon_fiber" rgba="0.15 0.15 0.15 1" specular="0.9" shininess="0.8"/>
        <material name="metallic" rgba="0.7 0.7 0.75 1" specular="1.0" shininess="1.0"/>
        <material name="cam_lens" rgba="0.02 0.02 0.05 1" specular="1.0" shininess="1.0"/>
        <material name="prop_front" rgba="0.1 0.1 0.1 0.4"/> <material name="prop_back" rgba="0.1 0.1 0.1 0.4"/>  
</asset>


    <worldbody>
        <geom name="floor" type="plane" size="150 150 0.1" material="grid_material" friction="1 0.005 0.0001"/>

        <body mocap="true" name="tracking_target" pos="0 0 0">
            <geom type="box" pos="0 0 0.10" size="0.48 0.20 0.04"
                    rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0.34 0 0.115" size="0.13 0.19 0.025"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="-0.34 0 0.115" size="0.11 0.19 0.025"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0.02 0 0.19" size="0.20 0.18 0.05"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0.02 0 0.24" size="0.17 0.17 0.006"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0.49 0 0.075" size="0.02 0.20 0.035"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="-0.47 0 0.075" size="0.02 0.20 0.035"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0.50 0 0.09" size="0.008 0.11 0.018"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0.50 0.15 0.10" size="0.008 0.04 0.02"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0.50 -0.15 0.10" size="0.008 0.04 0.02"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="-0.48 0.15 0.10" size="0.008 0.04 0.02"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="-0.48 -0.15 0.10" size="0.008 0.04 0.02"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="0.30 0.22 0.065" size="0.065 0.025"
                  rgba="0.6 0.07 0.07 1" euler="90 0 0" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="0.30 -0.22 0.065" size="0.065 0.025"
                  rgba="0.6 0.07 0.07 1" euler="90 0 0" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="-0.30 0.22 0.065" size="0.065 0.025"
                  rgba="0.6 0.07 0.07 1" euler="90 0 0" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="-0.30 -0.22 0.065" size="0.065 0.025"
                  rgba="0.6 0.07 0.07 1" euler="90 0 0" contype="0" conaffinity="0"/>
            <geom type="box" pos="0 0.20 0.065" size="0.35 0.005 0.015"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
            <geom type="box" pos="0 -0.20 0.065" size="0.35 0.005 0.015"
                  rgba="0.6 0.07 0.07 1" contype="0" conaffinity="0"/>
        </body>

        <!-- Body for the drone definition  imcludes cam, imu and rotors -->
        <body name="quadrotor" pos="-1.2 0 1.0">
            <inertial pos="0 0 0" mass="1.25" diaginertia="0.01 0.01 0.02"/>
            <freejoint name="drone_root"/>
            
            <geom type="box" size="0.06 0.06 0.02" material="carbon_fiber" mass="1.0"/>
            <geom type="box" pos="-0.04 0 -0.02" size="0.03 0.02 0.015" material="carbon_fiber" mass="0.116"/>
            <geom type="box" pos="0 0 0.03" size="0.04 0.04 0.005" material="carbon_fiber" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="0.03 0.03 0.015" size="0.003 0.015" material="metallic" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="-0.03 0.03 0.015" size="0.003 0.015" material="metallic" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="0.03 -0.03 0.015" size="0.003 0.015" material="metallic" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="-0.03 -0.03 0.015" size="0.003 0.015" material="metallic" contype="0" conaffinity="0"/>
            
            <camera name="rgbd_cam" pos="0.061 0.047 -0.065" xyaxes="0 -1 0  0.7071 0 0.7071" fovy="58"/>
            <geom type="box" pos="0.07 0 0.01" size="0.01 0.045 0.012" material="metallic" mass="0.05"/>
            <geom type="cylinder" pos="0.081 0.02 0.01" zaxis="1 0 0" size="0.006 0.002" material="cam_lens" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="0.081 -0.02 0.01" zaxis="1 0 0" size="0.006 0.002" material="cam_lens" contype="0" conaffinity="0"/>
            
            <site name="imu_site" pos="0 0 0" size="0.01" rgba="0 1 0 0"/>

            <!-- Body axes through the origin: X=forward=blue, Y=left=green, Z=up=red -->
            <geom type="capsule" fromto="-0.20 0 0  0.20 0 0" size="0.005"
                  rgba="0.1 0.35 1.0 0.95" contype="0" conaffinity="0" mass="0"/>
            <geom type="capsule" fromto="0 -0.20 0  0 0.20 0" size="0.005"
                  rgba="0.1 0.85 0.2 0.95" contype="0" conaffinity="0" mass="0"/>
            <geom type="capsule" fromto="0 0 -0.20  0 0 0.20" size="0.005"
                  rgba="1.0 0.12 0.08 0.95" contype="0" conaffinity="0" mass="0"/>

            <geom type="capsule" fromto="0.125 0.125 0 -0.125 -0.125 0" size="0.008" material="carbon_fiber" mass="0.05"/>
            <geom type="capsule" fromto="0.125 -0.125 0 -0.125 0.125 0" size="0.008" material="carbon_fiber" mass="0.05"/>

            <geom type="cylinder" pos="0.125 0.125 0.01" size="0.015 0.01" material="metallic" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="-0.125 0.125 0.01" size="0.015 0.01" material="metallic" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="-0.125 -0.125 0.01" size="0.015 0.01" material="metallic" contype="0" conaffinity="0"/>
            <geom type="cylinder" pos="0.125 -0.125 0.01" size="0.015 0.01" material="metallic" contype="0" conaffinity="0"/>

            <geom name="prop0" type="cylinder" pos="0.125 0.125 0.02" size="0.06 0.002" material="prop_front" mass="0.01"/>
            <site name="thrust0" pos="0.125 0.125 0.02" zaxis="0 0 1" size="0.01" rgba="1 0 0 0"/>
            
            <geom name="prop1" type="cylinder" pos="-0.125 0.125 0.02" size="0.06 0.002" material="prop_back" mass="0.01"/>
            <site name="thrust1" pos="-0.125 0.125 0.02" zaxis="0 0 1" size="0.01" rgba="1 0 0 0"/>
            
            <geom name="prop2" type="cylinder" pos="-0.125 -0.125 0.02" size="0.06 0.002" material="prop_back" mass="0.01"/>
            <site name="thrust2" pos="-0.125 -0.125 0.02" zaxis="0 0 1" size="0.01" rgba="1 0 0 0"/>
            
            <geom name="prop3" type="cylinder" pos="0.125 -0.125 0.02" size="0.06 0.002" material="prop_front" mass="0.01"/>
            <site name="thrust3" pos="0.125 -0.125 0.02" zaxis="0 0 1" size="0.01" rgba="1 0 0 0"/>
        </body>
    </worldbody>

    <actuator>
        <general name="m0" site="thrust0" ctrllimited="true" ctrlrange="0 20.0" gear="0 0 1 0 0  0.022"/>
        <general name="m1" site="thrust1" ctrllimited="true" ctrlrange="0 20.0" gear="0 0 1 0 0 -0.022"/>
        <general name="m2" site="thrust2" ctrllimited="true" ctrlrange="0 20.0" gear="0 0 1 0 0  0.022"/>
        <general name="m3" site="thrust3" ctrllimited="true" ctrlrange="0 20.0" gear="0 0 1 0 0 -0.022"/>
    </actuator>
    
    <sensor>
        <gyro name="gyro" site="imu_site" noise="0.2"/>
        <accelerometer name="accel" site="imu_site" noise="0.1"/>
    </sensor>



</mujoco>